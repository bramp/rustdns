//! DNS Zone file parsing (pre-processor)
//!
//! Flatten parenthesized continuations before the newline-delimited zone grammar,
//! keeping quoted and escaped punctuation separate from grouping and comments.


comment = { ";" ~ (!NEWLINE ~ ANY)* }
open = { "(" }
close = { ")" }
newline = { NEWLINE }
quoted = @{ "\"" ~ ("\\" ~ ANY | !("\"" | "\\") ~ ANY)* ~ "\"" }
escaped = @{ "\\" ~ ANY }
token = { (!(comment | open | close | newline | "\"" | "\\") ~ ANY)+ }

tokens = {
	(
	    quoted
	  | escaped
	  | comment
	  | open
	  | close
	  | newline
	  | token
	)*
}

file = {
	SOI ~ tokens ~ EOI
}
