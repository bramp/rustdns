//! DNS Zone file parsing
//!
//! Format is defined in RFC 1035 §5, extended RFC 2308 §4.
//!
//! ```text
//! <domain-name><rr> [<comment>]
//! <blank><rr> [<comment>]
//! ```
//!
//! <rr> contents take one of the following forms:
//! ```text
//! [<TTL>] [<class>] <type> <RDATA>
//! [<class>] [<TTL>] <type> <RDATA>
//! ```

// We use explict WHITESPACE to ensure there is whitespace between matching tokens
// as opposed to optional WHITESPACE.
ws = _{
	( " "
	| "\t"

	// Also match ( and ) because after preprocessing, we can effectively
	// ignore them. We only leave them in to make error printing, etc a
	// little nicer.
	| "(" | ")"
	)+
}

// Standard comment until end of line
COMMENT = _{";" ~ (!NEWLINE ~ ANY)*}

domain = @{ quoted | unquoted }
ip4 = @{ (ASCII_DIGIT | ".")+ }
ip6 = @{ (ASCII_HEX_DIGIT | ":")+ }
number = @{ ASCII_DIGIT+ }
duration = @{ ASCII_DIGIT+ }
class = @{ ^"IN" | ^"CS" | ^"CH" | ^"HS" }
type_name = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "-")* }
base64_string = @{ (ASCII_ALPHANUMERIC | "+" | "/" | "=")+ ~ (ws ~ (ASCII_ALPHANUMERIC | "+" | "/" | "=")+)* }
hex_string = @{ ASCII_HEX_DIGIT+ ~ (ws ~ ASCII_HEX_DIGIT+)* }

resource = _{
	  resource_a
	| resource_aaaa
	| resource_cname
	| resource_nsec
	| resource_ns
	| resource_mx
	| resource_srv
	| resource_ptr
	| resource_soa
	| resource_ds
	| resource_dnskey
	| resource_rrsig
	| resource_zonemd
	| resource_txt
	| resource_spf
	| resource_nsec3param
	| resource_nsec3
}

resource_a      = {^"A"      ~ ws ~ ip4}
resource_aaaa   = {^"AAAA"   ~ ws ~ ip6}
resource_cname  = {^"CNAME"  ~ ws ~ domain}
resource_nsec   = {^"NSEC"   ~ ws ~ nsec_rdata}
resource_ns     = {^"NS"     ~ ws ~ domain}
resource_mx     = {^"MX"     ~ ws ~ mx_rdata}
resource_srv    = {^"SRV"    ~ ws ~ srv_rdata}
resource_ptr    = {^"PTR"    ~ ws ~ domain}
resource_soa    = {^"SOA"    ~ ws ~ soa_rdata}
soa_rdata      = @{ soa_fields }
soa_mname      = _{ domain }
soa_rname      = _{ domain }
separator      = _{ ws }
resource_ds     = {^"DS"     ~ ws ~ ds_rdata}
resource_dnskey = {^"DNSKEY" ~ ws ~ dnskey_rdata}
resource_rrsig  = {^"RRSIG"  ~ ws ~ rrsig_rdata}
resource_zonemd = {^"ZONEMD" ~ ws ~ zonemd_rdata}
resource_txt    = {^"TXT"    ~ ws ~ txt_rdata}
resource_spf    = {^"SPF"    ~ ws ~ txt_rdata}
resource_nsec3param = {^"NSEC3PARAM" ~ ws ~ nsec3param_rdata}
resource_nsec3  = {^"NSEC3"  ~ ws ~ nsec3_rdata}
txt_rdata      = @{ (quoted | unquoted) ~ (separator ~ (quoted | unquoted))* }
nsec3_rdata    = @{ nsec3_fields }
nsec3param_rdata = @{ nsec3param_fields }
mx_rdata       = @{ mx_fields }
srv_rdata      = @{ srv_fields }
ds_rdata       = @{ ds_fields }
dnskey_rdata   = @{ dnskey_fields }
rrsig_rdata    = @{ rrsig_fields }
nsec_rdata     = @{ nsec_fields }
zonemd_rdata   = @{ zonemd_fields }
rdata_name     = _{ domain }
algorithm      = _{ number }
digest_type    = _{ number }
record_type    = _{ type_name }
signature_time = _{ number }
hex_data       = _{ hex_string }
base64_data    = _{ base64_string }

// Entry for a full file after preprocessing parenthesized continuations.
file = {
	entry ~ (NEWLINE ~ entry)* ~ EOI
}

// Entry for a single resource record.
single_record = {
	SOI ~ ws? ~ record ~ ws? ~ EOI
}

entry = _{
	ws? ~ (
		  origin
		| ttl
	      | record
	      | ws? // blank record
	) ~ ws?
}

origin = {
	^"$ORIGIN" ~ ws ~ domain
}

ttl = {
	^"$TTL" ~ ws ~ duration
}

record = { 
	// This is perhaps more verbose than needed, but this ensures
	// we parse this ambiguous text in a well defined order.
	// For example, "IN" could be a domain, or a class.

	// All arguments are provided
	  (domain ~ ws ~ duration ~ ws ~ class ~ ws ~ resource)
	| (domain ~ ws ~ class ~ ws ~ duration ~ ws ~ resource)

	// No domain provided, but match these first, we assume IN means class, not domain
	| (duration ~ ws ~ class ~ ws ~ resource)
	| (duration ~ ws ~ resource)
	| (class ~ ws ~ duration ~ ws ~ resource)
	| (class ~ ws ~ resource)

	// Match the ones listing domains
	| (domain ~ ws ~ class ~ ws ~ resource)
	| (domain ~ ws ~ duration ~ ws ~ resource)
	| (domain ~ ws ~ resource)

	// Finally no domain.
	| resource
}
