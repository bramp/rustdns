// RFC 1035 section 5.1. Adjacent quoted strings are also accepted for DoH JSON.
txt = ${ SOI ~ space* ~ quoted ~ (space* ~ quoted)* ~ space* ~ EOI }
space = _{ " " | "\t" | "\r" | "\n" }
quoted = { "\"" ~ (decimal_escape | character_escape | text)* ~ "\"" }
decimal_escape = @{ "\\" ~ ASCII_DIGIT{3} }
character_escape = @{ "\\" ~ !ASCII_DIGIT ~ ANY }
text = @{ (!("\"" | "\\") ~ ANY)+ }

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

field = @{ (!(" " | "\t" | "\r" | "\n") ~ ANY)+ }
number = @{ ASCII_DIGIT+ }
hex_fragment = @{ ASCII_HEX_DIGIT+ }
base64_fragment = @{ (ASCII_ALPHANUMERIC | "+" | "/" | "=")+ }

soa = ${ SOI ~ space* ~ soa_fields ~ space* ~ EOI }
soa_mname = _{ field }
soa_rname = _{ field }
separator = _{ space+ }
rdata_name = _{ field }
algorithm = _{ field }
digest_type = _{ field }
record_type = _{ field }
signature_time = _{ field }
hex_data = _{ hex_fragment ~ (separator ~ hex_fragment)* }
base64_data = _{ base64_fragment ~ (separator ~ base64_fragment)* }
mx = ${ SOI ~ space* ~ mx_fields ~ space* ~ EOI }
srv = ${ SOI ~ space* ~ srv_fields ~ space* ~ EOI }
ds = ${ SOI ~ space* ~ ds_fields ~ space* ~ EOI }
dnskey = ${ SOI ~ space* ~ dnskey_fields ~ space* ~ EOI }
rrsig = ${ SOI ~ space* ~ rrsig_fields ~ space* ~ EOI }
nsec = ${ SOI ~ space* ~ nsec_fields ~ space* ~ EOI }
zonemd = ${ SOI ~ space* ~ zonemd_fields ~ space* ~ EOI }
