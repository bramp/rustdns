// Separators and name syntax depend on whether the input is RDATA or a zone.
soa_fields = _{
    soa_mname ~ separator ~ soa_rname ~ separator ~ soa_number ~ separator ~
    soa_number ~ separator ~ soa_number ~ separator ~ soa_number ~ separator ~ soa_number
}
soa_number = @{ ASCII_DIGIT+ }

mx_fields = _{ number ~ separator ~ rdata_name }
srv_fields = _{ number ~ separator ~ number ~ separator ~ number ~ separator ~ rdata_name }
ds_fields = _{ number ~ separator ~ algorithm ~ separator ~ digest_type ~ separator ~ hex_data }
dnskey_fields = _{ number ~ separator ~ number ~ separator ~ algorithm ~ separator ~ base64_data }
rrsig_fields = _{
    record_type ~ separator ~ algorithm ~ separator ~ number ~ separator ~ number ~ separator ~
    signature_time ~ separator ~ signature_time ~ separator ~ number ~ separator ~ rdata_name ~ separator ~ base64_data
}
nsec_fields = _{ rdata_name ~ (separator ~ record_type)* }
zonemd_fields = _{ number ~ separator ~ number ~ separator ~ number ~ separator ~ hex_data }
nsec3param_fields = _{ number ~ separator ~ number ~ separator ~ number ~ separator ~ salt }
nsec3_fields = _{ nsec3param_fields ~ separator ~ next_hash ~ (separator ~ record_type)* }
salt = @{ "-" | ASCII_HEX_DIGIT+ }
next_hash = @{ (ASCII_DIGIT | 'A'..'V' | 'a'..'v')+ }

quoted = ${ "\"" ~ (decimal_escape | character_escape | text)* ~ "\"" }
unquoted = ${ (decimal_escape | character_escape | unquoted_text)+ }
decimal_escape = @{ "\\" ~ ASCII_DIGIT{3} }
character_escape = @{ "\\" ~ !ASCII_DIGIT ~ ANY }
text = @{ (!("\"" | "\\") ~ ANY)+ }
unquoted_text = @{ (!(" " | "\t" | "\r" | "\n" | "\"" | "\\" | ";" | "(" | ")") ~ ANY)+ }
